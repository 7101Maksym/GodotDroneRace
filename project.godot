; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Drone race"
run/main_scene="uid://kscsqa0klhyp"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

BulletContainer="*uid://2dmnudhholv4"
NodeGetter="*uid://dqqhmiucp5huh"
WeaponsSetter="*uid://bd8lagmh1od7k"

[display]

window/size/viewport_width=1800
window/size/viewport_height=900

[editor_plugins]

enabled=PackedStringArray("res://addons/virtual_joystick/plugin.cfg")

[global_group]

healths_objects="Objects that can take and cause damage"

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="Enemy"
2d_physics/layer_3="ObstaclesForPlayer"
2d_physics/layer_4="ObstaclesForEnemys"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
